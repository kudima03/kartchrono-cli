<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CheckForOverflowUnderflow>true</CheckForOverflowUnderflow>
    <IsAotCompatible>true</IsAotCompatible>
    <InvariantGlobalization>false</InvariantGlobalization>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>kartchrono</ToolCommandName>
    <RootNamespace>KartChrono.Cli</RootNamespace>
    <EnablePackageValidation>true</EnablePackageValidation>
    <PackageValidationBaselineVersion>1.0.0</PackageValidationBaselineVersion>
  </PropertyGroup>
  <PropertyGroup>
    <PackageId>KartChrono.Cli</PackageId>
    <Authors>Dmitry Kurochkin</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/kudima03/kartchrono-cli</PackageProjectUrl>
    <PackageDescription>Query and monitor KartChrono live karting timing from the terminal.</PackageDescription>
    <PackageTags>karting;timing;cli;kartchrono</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\KartChrono\KartChrono.csproj" />
    <ProjectReference Include="..\KartChrono.Abstractions\KartChrono.Abstractions.csproj" />
  </ItemGroup>
</Project>
